generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Cashbacker {
  id               Int    @id @unique @default(autoincrement())
  name             String @db.VarChar(255)
  logoUrl          String
  score            Int    @default(0)
  rank             Int    @default(0)
  signupBonus      Int    @default(0)
  paymentThreshold Float  @default(0)
  paymentMethod    String @default("virement bancaire") @db.VarChar(255)
  sponsorshipUrl   String
  reviewsUrl       String
}

// The unit of rate
enum RateUnit {
  Euro    @map("EURO")
  Percent @map("PERCENT")
  None    @map("NONE")
}

model Category {
  id   Int    @id @unique @default(autoincrement())
  name String @db.VarChar(255)

  sellers CategoriesOnSellers[]
}

model Seller {
  id        Int      @id @unique @default(autoincrement())
  name      String   @db.VarChar(255)
  logoUrl   String?
  slug      String?
  top40     Boolean? @default(false)
  topSeller Boolean? @default(false)
  coupon    Boolean? @default(false)

  categories CategoriesOnSellers[]

  isRangeRateIgraal Boolean?  @default(false)
  rateIgraal        Float?    @default(0)
  unitRateIgraal    RateUnit?

  isRangeRatePoulpeo Boolean?  @default(false)
  ratePoulpeo        Float?    @default(0)
  unitRatePoulpeo    RateUnit?

  isRangeRateFlouzy Boolean?  @default(false)
  rateFlouzy        Float?    @default(0)
  unitRateFlouzy    RateUnit?

  isRangeRateCapitalKoala Boolean?  @default(false)
  rateCapitalKoala        Float?    @default(0)
  unitRateCapitalKoala    RateUnit?

  isRangeRateEbuyclub Boolean?  @default(false)
  rateEbuyclub        Float?    @default(0)
  unitRateEbuyclub    RateUnit?

  isRangeRateWidilo Boolean?  @default(false)
  rateWidilo        Float?    @default(0)
  unitRateWidilo    RateUnit?

  isRangeRateJoko Boolean?  @default(false)
  rateJoko        Float?    @default(0)
  unitRateJoko    RateUnit?

  isRangeRateBoursorama Boolean?  @default(false)
  rateBoursorama        Float?    @default(0)
  unitRateBoursorama    RateUnit?

  isRangeRateEbuyclubCoupon Boolean?  @default(false)
  rateEbuyclubCoupon        Float?    @default(0)
  unitRateEbuyclubCoupon    RateUnit?
}

model CategoriesOnSellers {
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId   Int // relation scalar field (used in the `@relation` attribute above)

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int // relation scalar field (used in the `@relation` attribute above)

  @@id([sellerId, categoryId])
}

model UserMessage {
  id      Int    @id @unique @default(autoincrement())
  email   String @db.VarChar(255)
  name    String @db.VarChar(255)
  message String @db.VarChar(255)

  createdAt DateTime @default(now())
}

model Administrator {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)

  connectionToken String? @db.VarChar(255)

  createdAt DateTime @default(now())
}

 
// V2 models are isolated from legacy tables; no V1 model is changed.
model SellerV2 {
  id Int @id @default(autoincrement())
  name String @db.VarChar(255)
  logoUrl String? @db.Text
  slug String? @db.Text
  top40 Boolean? @default(false)
  topSeller Boolean? @default(false)
  coupon Boolean? @default(false)
  websiteDomain String? @db.VarChar(255)
  isActive Boolean @default(true)
  description String? @db.Text
  redirectSellerId Int?
  redirectSeller SellerV2? @relation("SellerV2Redirect", fields: [redirectSellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  redirectedSellers SellerV2[] @relation("SellerV2Redirect")
  categories CategoriesOnSellersV2[]
  offers CashbackOfferV2[]
  @@index([redirectSellerId])
}

model CashbackerV2 {
  id Int @id @default(autoincrement())
  name String @db.VarChar(255)
  logoUrl String @db.Text
  score Int @default(0)
  rank Int @default(0)
  signupBonus Int @default(0)
  paymentThreshold Float @default(0)
  paymentMethod String @default("virement bancaire") @db.VarChar(255)
  sponsorshipUrl String @db.Text
  reviewsUrl String @db.Text
  isActive Boolean @default(true)
  offers CashbackOfferV2[]
}

model CategoryV2 {
  id Int @id @default(autoincrement())
  name String @db.VarChar(255)
  parentId Int?
  parent CategoryV2? @relation("CategoryV2Hierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CategoryV2[] @relation("CategoryV2Hierarchy")
  sellers CategoriesOnSellersV2[]
  @@index([parentId])
}

model CategoriesOnSellersV2 {
  seller SellerV2 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId Int
  category CategoryV2 @relation(fields: [categoryId], references: [id])
  categoryId Int
  isPrimary Boolean @default(false)
  @@id([sellerId, categoryId])
}

enum CashbackOfferTypeV2 {
  WEB
  GIFT_CARD
  AUTOMATIC
}

model CashbackOfferV2 {
  id Int @id @default(autoincrement())
  seller SellerV2 @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId Int
  cashbacker CashbackerV2 @relation(fields: [cashbackerId], references: [id], onDelete: Restrict)
  cashbackerId Int
  type CashbackOfferTypeV2
  rate Float
  unit RateUnit
  isRangeRate Boolean @default(false)
  description String? @db.Text
  url String? @db.VarChar(2048)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastCheckedAt DateTime?
  @@unique([sellerId, cashbackerId, type])
  @@index([sellerId, type, isActive])
  @@index([cashbackerId, type])
}
